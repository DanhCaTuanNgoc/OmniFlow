{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "OmniFlow Backend Service — Compiler, Relayer & WebSocket Gateway",
  "main": "dist/index.js",
  "scripts": {
    "dev": "pnpm --filter @omniflow/shared build && tsx watch src/index.ts",
    "build": "pnpm --filter @omniflow/shared build && tsc",
    "start": "node dist/index.js",
    "test": "pnpm --filter @omniflow/shared build && node --import tsx --test test/deployer.test.ts test/nodes.test.ts"
  },
  "dependencies": {
    "@omniflow/shared": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "viem": "^2.21.45",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.6",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
