{
  "name": "omniflow-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "OmniFlow — The Zapier of Web3: No-Code Cross-Chain Automation Powered by Reactive Omni",
  "scripts": {
    "dev": "pnpm --parallel --filter backend --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "build:backend": "pnpm --filter backend build",
    "build:frontend": "pnpm --filter frontend build",
    "build": "pnpm --filter \"@omniflow/*\" --filter backend --filter frontend build"
  },
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.0.0"
  }
}
